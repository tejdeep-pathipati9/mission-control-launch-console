# Host-only backend development; Compose stores its database in the named /data volume.
MISSION_CONTROL_DB_PATH=data/mission_control.db
# Local demo auth: set distinct random tokens (32–256 ASCII characters, no spaces).
# No default director access. The engineer token is optional and cannot approve.
DEMO_DIRECTOR_TOKEN=
DEMO_ENGINEER_TOKEN=
# Live model configuration. Without a key, reports record unknown/high with a configuration warning.
# Leave secrets in the environment or a local ignored .env file, never in source control.
MODEL_PROVIDER=foundry
ANTHROPIC_FOUNDRY_API_KEY=
# Set your resource name OR the base URL below, not both.
ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/anthropic/
# Use your deployment name from Foundry; change this if you chose a custom name.
ANTHROPIC_MODEL=claude-opus-5
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=1024
# Claude Opus 5, Foundry Global Standard list prices (USD per million tokens).
# Verified 2026-11-18: https://platform.claude.com/docs/en/about-claude/pricing
# Configure all three to calculate costs. Replace for other models or negotiated rates.
# US Data Zone Standard uses a 1.1x multiplier on every rate below.
FOUNDRY_INPUT_USD_PER_MILLION=5
FOUNDRY_CACHED_INPUT_USD_PER_MILLION=0.50
FOUNDRY_OUTPUT_USD_PER_MILLION=25
# Required to price nonzero cache writes at the corresponding TTL.
FOUNDRY_CACHE_WRITE_5M_USD_PER_MILLION=6.25
FOUNDRY_CACHE_WRITE_1H_USD_PER_MILLION=10
